#!/usr/bin/env python3
"""Entry point, run as: ./render-schedule --schedule=... --overrides=... --from=... --until=..."""

import sys

# Checked before importing anything else, so older Pythons get a clear message
# rather than a confusing error (e.g. "Z" timestamps only parse on 3.11+).
if sys.version_info < (3, 11):
    sys.exit("render-schedule requires Python 3.11 or newer")

from scheduler.cli import main  # noqa: E402  (import after the version check)

sys.exit(main())
